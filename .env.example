# Tariff Compass runs fully offline with these defaults: no accounts, no keys, no Docker.
# Copy to .env (make setup does it) and change only what you need.

# ── Django ──
DJANGO_ENV=dev
# SECRET_KEY=change-me-in-production
# DATABASE_URL=sqlite:///data/tariffcompass.db          # or postgres://user:pass@host:5432/tariffcompass
WEB_ORIGIN=http://localhost:3050
LOG_LEVEL=INFO

# ── Demo clock: the app believes it is this day (and, optionally, this time in America/Vancouver) ──
TARIFF_COMPASS_DEMO_TODAY=2026-02-19
TARIFF_COMPASS_DEMO_TIME=10:30
# TARIFF_COMPASS_DEMO_TODAY=real                        # use the wall clock instead

# ── The classifier's language model (offline simulator unless LLM_FAKE=false and a key is set) ──
LLM_FAKE=true
LITELLM_MODEL=groq/llama-3.3-70b-versatile
LITELLM_REFLECTION_MODEL=gemini/gemini-2.5-flash
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=                                    # e.g. LITELLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# ── Photos and embeddings (offline fakes by default) ──
VISION_FAKE=true
# VISION_MODEL=gemini/gemini-2.5-flash
EMBEDDINGS=fake
# JINA_API_KEY=
# COHERE_API_KEY=

# ── Jobs ──
# HUEY_IMMEDIATE=true                                    # run background jobs inline (single-process demo)
# HUEY_WORKERS=1

# ── Product rules ──
ALWAYS_REVIEW_VALUE_USD=25000
RETENTION_YEARS=5
